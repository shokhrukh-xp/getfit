#!/bin/sh
# 27.10: автоматический выбор проверок по просьбе Шохруха.
# 28.10: правка логики тоже адресно (функции/строки/селекторы правки + ui-clean и
# тыкалка), полный — после push в фоне. Полный до выпуска: крупное, общий код
# прогона, неизвестные файлы. GETFIT_FULL=1 — полный руками.
cd "$(git rev-parse --show-toplevel)" || exit 1
export PATH="$PATH:/usr/local/bin:/opt/homebrew/bin"
node tools/check-plan.test.cjs || exit 1
REFILE=$(mktemp "${TMPDIR:-/tmp}/getfit-refs.XXXXXX") || exit 1
PLANFILE=$(mktemp "${TMPDIR:-/tmp}/getfit-plan.XXXXXX") || exit 1
trap 'rm -f "$REFILE" "$PLANFILE"' EXIT HUP INT TERM
NULL=0000000000000000000000000000000000000000
FULL=0; REFS=0
while read lref lsha rref rsha; do
  [ "$lsha" = "$NULL" ] && continue
  REFS=1
  if [ "$rsha" = "$NULL" ]; then rsha=$(git merge-base "$lsha" origin/main 2>/dev/null) || { FULL=1; continue; }; fi
  printf '%s\t%s\n' "$rsha" "$lsha" >> "$REFILE"
done
if [ $REFS = 0 ] && [ $# -ge 2 ]; then echo "pre-push: отправлять нечего."; exit 0; fi
[ $REFS = 1 ] || FULL=1
APPB=$(sed -n "s/^var BUILD = '\([^']*\)'.*/\1/p" index.html | head -1)
if [ -f ../getfit-sync/src/index.js ]; then
  SRVB=$(sed -n "s/^const APP_BUILD = '\([^']*\)'.*/\1/p" ../getfit-sync/src/index.js | head -1)
  if [ -z "$APPB" ] || [ "$APPB" != "$SRVB" ]; then
    echo "pre-push: МЕТКИ СБОРКИ РАЗНЫЕ: приложение «$APPB», сервер «$SRVB»."; exit 1
  fi
fi
node tools/check-plan.cjs "$REFILE" > "$PLANFILE" || exit 1
MODE=$(node -e 'console.log(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).mode)' "$PLANFILE") || exit 1
[ "$FULL" = 0 ] || MODE=full
[ "${GETFIT_FULL:-0}" != 1 ] || MODE=full
node -e 'console.log("pre-push: "+JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).reason)' "$PLANFILE"
case "$MODE" in
  meta) echo "pre-push: метка $APPB сверена; настройка проверок проверена."; exit 0 ;;
  targeted)
    TESTS=$(node -e 'console.log(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).tests.join(" "))' "$PLANFILE") || exit 1
    echo "pre-push: адресный прогон — $TESTS"
    set -- $TESTS ;;
  full) echo "pre-push: полный прогон приложения"; set -- ;;
  *) echo "pre-push: неизвестный план — остановка"; exit 1 ;;
esac
if sh tg/run.sh "$@" > "${TMPDIR:-/tmp}/getfit-pre-push.log" 2>&1; then
  grep -E "^Метка|^Известные|^За |ВСЕ НАБОРЫ" "${TMPDIR:-/tmp}/getfit-pre-push.log"
  # 28.10: адресно перед выпуском — полный сразу после, в фоне (tools/full-after.sh)
  if [ "$MODE" = targeted ] && [ "${GETFIT_NO_AFTER:-0}" != 1 ]; then
    SHA=$(tail -1 "$REFILE" | cut -f2)
    nohup sh tools/full-after.sh "$SHA" >/dev/null 2>&1 &
    echo "pre-push: полный прогон запущен в фоне для ${SHA%${SHA#???????}} — итог: sh tools/full-after.sh --status"
  fi
  exit 0
fi
grep -E "✗|ПРОВАЛ|УПАЛО|МЕТКИ|^За " "${TMPDIR:-/tmp}/getfit-pre-push.log" | head -40
echo "pre-push: красное — push остановлен. Лог: ${TMPDIR:-/tmp}/getfit-pre-push.log"
exit 1
